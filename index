function handleUpdateReservation(ReservaRepository $reservaRepository, HabitacionRepository $habitacionRepository, NotificacionRepository $notificacionRepository, $id, $data)
{
    // Requiere autenticación y autorización: solo el propio usuario o admin
    if (!ValidationHelper::isValidNumeroEntero($id)) {
        jsonResponse(['error' => 'ID de reserva inválido.'], 400);
    }

    $reserva = $reservaRepository->buscarReservaPorId($id);
    if (!$reserva) {
        jsonResponse(['error' => 'Reserva no encontrada.'], 404);
    }

    // Lógica para verificar que el usuario actual es dueño de la reserva o es admin.
    // Ej: $loggedInUserId = getLoggedInUserId(); if ($reserva->getUsuarioId() !== $loggedInUserId && !isAdmin()) { ... }

    $nuevaFechaInicio = $data['fechaInicio'] ?? $reserva->getFechaInicio();
    $nuevaFechaFin = $data['fechaFin'] ?? $reserva->getFechaFin();
    $nuevaHabitacionId = $data['habitacionId'] ?? $reserva->getHabitacion()->getId();
    $nuevoCosto = $data['costo'] ?? $reserva->getCosto();

    if (!ValidationHelper::isValidDateFormat($nuevaFechaInicio) || !ValidationHelper::isValidDateFormat($nuevaFechaFin) ||
        !ValidationHelper::isEndDateAfterStartDate($nuevaFechaInicio, $nuevaFechaFin) ||
        !ValidationHelper::isValidNumeroEntero($nuevaHabitacionId) || !ValidationHelper::isValidPrecio($nuevoCosto)) {
        jsonResponse(['error' => 'Datos de actualización de reserva incompletos o inválidos.'], 400);
    }

    $nuevaHabitacion = $habitacionRepository->obtenerHabitacionPorId($nuevaHabitacionId);
    if (!$nuevaHabitacion) {
        jsonResponse(['error' => 'Nueva habitación no encontrada.'], 404);
    }

    if ($reservaRepository->modificarReserva($id, $nuevaFechaInicio, $nuevaFechaFin, $nuevaHabitacion, $nuevoCosto)) {
        $mensaje = "Tu reserva ID: {$id} ha sido modificada. Nuevas fechas: {$nuevaFechaInicio} a {$nuevaFechaFin}. Habitación: {$nuevaHabitacion->getNumero()}.";
        $notificacion = new Notificacion(null, $id, $mensaje, $reserva->getUsuarioId());
        $notificacionRepository->guardarNotificacion($notificacion);
        jsonResponse(['message' => 'Reserva actualizada correctamente.']);
    } else {
        jsonResponse(['error' => 'No se pudo actualizar la reserva o la habitación no está disponible.'], 409);
    }
}

function handleCancelReservation(ReservaRepository $reservaRepository, NotificacionRepository $notificacionRepository, $id)
{
    // Requiere autenticación y autorización: solo el propio usuario o admin
    if (!ValidationHelper::isValidNumeroEntero($id)) {
        jsonResponse(['error' => 'ID de reserva inválido.'], 400);
    }

    $reserva = $reservaRepository->buscarReservaPorId($id);
    if (!$reserva) {
        jsonResponse(['error' => 'Reserva no encontrada.'], 404);
    }

    // Lógica para verificar que el usuario actual es dueño de la reserva o es admin.
    // Ej: $loggedInUserId = getLoggedInUserId(); if ($reserva->getUsuarioId() !== $loggedInUserId && !isAdmin()) { ... }

    if ($reservaRepository->eliminarReserva($id)) {
        $mensaje = "Tu reserva ID: {$id} ha sido cancelada.";
        $notificacion = new Notificacion(null, $id, $mensaje, $reserva->getUsuarioId());
        $notificacionRepository->guardarNotificacion($notificacion);
        jsonResponse(['message' => 'Reserva cancelada correctamente.']);
    } else {
        jsonResponse(['error' => 'No se pudo cancelar la reserva.'], 500);
    }
}

function handleGetUserNotifications(NotificacionRepository $notificacionRepository, $userId)
{
    // Requiere autenticación y autorización: solo el propio usuario o admin
    if (!ValidationHelper::isValidNumeroEntero($userId)) {
        jsonResponse(['error' => 'ID de usuario inválido.'], 400);
    }

    $notificaciones = $notificacionRepository->obtenerNotificacionesPorUsuarioId($userId);
    $data = array_map(function($n) {
        return [
            'id' => $n->getId(),
            'reservaId' => $n->getReservaId(),
            'mensaje' => $n->getMensaje(),
            'usuarioId' => $n->getUsuarioId()
        ];
    }, $notificaciones);
    jsonResponse($data);
}

